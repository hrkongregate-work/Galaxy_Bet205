{
  "name": "galaxy-bet205-monorepo",
  "version": "1.0.0",
  "scripts": {
    "prestart": "node scripts/free-ports.js",
    "dev:server": "npm run dev --prefix backend",
    "dev:client": "npm run dev --prefix client",
    "start": "cross-env NODE_OPTIONS=--no-deprecation concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^5.3.0",
    "cross-env": "^10.1.0"
  }
}